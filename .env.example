# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1

# ---- Auth (NextAuth) ----
NEXTAUTH_URL=http://localhost:3000
# Uret: openssl rand -base64 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Database ----
MONGODB_URI=mongodb://localhost:27017/iban
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# ---- Crypto ----
# 64 karakterlik hex string. Uret: openssl rand -hex 32
ENCRYPTION_KEY=

# ---- Third party APIs ----
IBAN_API_KEY=
NEXT_PUBLIC_CRYPTO_API_URL=https://api.coingecko.com/api/v3

# ---- Analytics ----
GA_ID=
HOTJAR_SITE_ID=

# ---- Storage (S3 / R2) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_STORAGE_URL=
R2_ACCOUNT_ID=

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# ---- Performance ----
NEXT_IMAGE_CACHE_TTL=31536000
COMPRESS_ENABLED=true
REDIS_MAX_CONNECTIONS=10
